# Copy this file to .env and adjust the values. Never put secrets in this example file.

# Port the HTTP server listens on
PORT=3002

# Where the main server is reached
MAIN_SERVER_URL=http://localhost:3000

# The secret that the main server expects with what the worker sends: the WORKER_TOKEN line of main-server/.env.
# WORKER_TOKEN=

# Whether the schedule starts extra.snu's Collections is the main server's global setting collection.extraSnu, which the
# worker asks before each one (main-server/.env.example: EXTRA_SNU_COLLECTION).

# How the server prints its log, text by default: NestJS's coloured text. json prints each entry as one JSON line, as
# Production does for its log collector (main-server README: Logging).
# LOG_FORMAT=text
