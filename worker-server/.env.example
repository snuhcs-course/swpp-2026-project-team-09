# Copy this file to .env and adjust the values. Never put secrets in this example file.

# Port the HTTP server listens on
PORT=3002

# Where the main server is reached
MAIN_SERVER_URL=http://localhost:3000

# The secret that the main server expects with what the worker sends: the WORKER_TOKEN line of main-server/.env.
# WORKER_TOKEN=

# Whether the schedule starts extra.snu's Collections, off by default. Leave it off until the rules that keep the same
# event from showing twice are deployed (infra/production/README.md).
# EXTRA_SNU_COLLECTION=off
