# The main server's address, read only on the server, such as http://localhost:3000.
MAIN_SERVER_URL=
# Client ID of the admin site's Google client, the same as the main server's GOOGLE_ADMIN_CLIENT_ID. Ships to the browser.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# The JavaScript key of the team's Kakao app, for the maps. Ships to the browser, and works only on the addresses
# registered under JavaScript SDK domains (http://localhost:3100). Left empty, the forms take the position as two numbers.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
