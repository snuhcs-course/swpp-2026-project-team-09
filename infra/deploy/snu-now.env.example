# The Dev Server's settings file, /srv/team/snu-now-secrets/snu-now.env, as infra/deploy/bootstrap.sh writes it.
# Compose reads it with --env-file, and compose.deploy.yaml hands each service the variables it takes; each server's own
# .env.example says more about them. A person fills in every CHANGE_ME: the deploy run refuses to start while one is
# left.

# Compose: turns the demo profile on, for demo-seed and demo-walker
COMPOSE_PROFILES=demo
# proxy: the folder of the deploy run's status file, served at /deploy-status
DEPLOY_STATUS_DIR=/srv/team/snu-now-status
# proxy: the folder of the dev APKs, listed at /apk/
DEPLOY_APK_DIR=/srv/team/snu-now-apk

# Written by the bootstrap. postgres: the superuser's password
POSTGRES_PASSWORD=
# Written by the bootstrap. postgres, main-server and demo-seed: the main database role's password, in DATABASE_URL
MAIN_DB_PASSWORD=
# Written by the bootstrap. main-server: the ES256 private key that signs access tokens, as one-line PEM
ACCESS_TOKEN_PRIVATE_KEY=
# Written by the bootstrap. main-server and socket-server: the public key of that pair, as one-line PEM
ACCESS_TOKEN_PUBLIC_KEY=
# Written by the bootstrap. main-server and worker-server: the secret the worker sends with what it collects
WORKER_TOKEN=

# main-server: the Dev Server's public address, from which Invite Links are built
PUBLIC_URL=http://swpp26t09.147-46-242-174.sslip.io
# main-server: the OAuth client ID of the app's Google client
GOOGLE_APP_CLIENT_ID=1021723676612-aria1ohmdms787sqbvldtt8484fnf04c.apps.googleusercontent.com
# main-server: the OAuth client ID of the admin site's Google client
GOOGLE_ADMIN_CLIENT_ID=1021723676612-23lpoe5ue36rr2a07uora5ai4qckoe87.apps.googleusercontent.com
# main-server: the fingerprint of the Expo template's debug key, which signs the dev APK
ANDROID_CERTIFICATE_FINGERPRINTS=FA:C6:17:45:DC:09:03:78:6F:B9:ED:E6:2A:96:2B:39:9F:73:48:F0:BB:6F:89:9B:83:32:66:75:91:03:3B:9C
# main-server: the OpenRouter id of the model the Assistant uses
ASSISTANT_MODEL=anthropic/claude-haiku-5.5

# A person fills it in. main-server: the REST API key of the team's Kakao app, which its Owner shares
KAKAO_REST_API_KEY=CHANGE_ME
# A person fills it in. main-server: the four members' addresses, separated by commas, as the first Administrators
INITIAL_ADMINISTRATOR_EMAILS=CHANGE_ME
# A person fills it in. demo-seed: the four members' SNU addresses, separated by commas, as the Demo Accounts
DEMO_ACCOUNT_EMAILS=CHANGE_ME

# A person may fill it in. Left empty, not CHANGE_ME, it turns only the Assistant off, not the deploy run.
# main-server: the Assistant's OpenRouter key, as main-server/.env.example describes
OPENROUTER_API_KEY=
