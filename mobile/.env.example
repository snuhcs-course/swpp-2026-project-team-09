# Copy this file to `.env` and fill in the values. `.env` is not committed. See README.md, "Google sign-in" and "The settings".

# The main server's Google client, of type "Web application". Google issues the ID token for it.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# The Google client of type "iOS". Only the iOS build needs it.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# The iOS client's ID reversed, which starts with `com.googleusercontent.apps.`. Only the iOS build needs it.
GOOGLE_IOS_URL_SCHEME=

# The Kakao native app key, from the team's Kakao app under [앱] > [플랫폼 키]. The Owner shares it privately.
# The app's configuration reads it when a native build is made.
KAKAO_NATIVE_APP_KEY=
