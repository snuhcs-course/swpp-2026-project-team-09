EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
EXPO_PUBLIC_SOCKET_URL=http://127.0.0.1:3002
EXPO_PUBLIC_MATCH_URL=http://127.0.0.1:3004
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Native Naver Cloud Maps Client ID only; never include a Client Secret.
NAVER_MAP_CLIENT_ID=

# Local prototype only: permits HTTP solely to loopback/Android emulator host.
# Use adb reverse for ports 3000, 3002, and 3004. Disable for HTTPS deployments.
PROTOTYPE_LOCAL_HTTP=true
