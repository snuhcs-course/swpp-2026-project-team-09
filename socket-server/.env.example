# Copy this file to .env and adjust the values. Never put secrets in this example file.
# The values reach the Redis that compose.yaml at the repository root starts.

# Port the HTTP server listens on
PORT=3001

# Redis, which carries NestJS messaging between the servers
REDIS_HOST=localhost
REDIS_PORT=6379

# The main server's public key for access tokens (ES256, P-256), written as PEM text on one line with \n. The socket
# server verifies access tokens with it alone and is never given the private key. Copy it from main-server/.env, where
# `pnpm keys:generate` wrote it:
#   grep ACCESS_TOKEN_PUBLIC_KEY ../main-server/.env >> .env
# ACCESS_TOKEN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
