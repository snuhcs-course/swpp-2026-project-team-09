# Copy this file to .env and adjust the values. Never put secrets in this example file.
# The values reach the database that compose.yaml at the repository root starts.

# Port the HTTP server listens on
PORT=3003

# The match database, reached with the match server's own role
DATABASE_URL=postgresql://match:match@localhost:5432/match

# The secret that the main server and this server send with each call to the other: the MATCH_SERVER_TOKEN line of
# main-server/.env.
# MATCH_SERVER_TOKEN=
