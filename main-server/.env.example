# Copy this file to .env and adjust the values. Never put secrets in this example file.
# The values reach the data stores that compose.yaml at the repository root starts.

# Port the HTTP server listens on
PORT=3000

# The main database, reached with the main server's own role
DATABASE_URL=postgresql://main:main@localhost:5432/main

# Redis, which carries NestJS messaging between the servers
REDIS_HOST=localhost
REDIS_PORT=6379

# Access tokens are signed with an ES256 (P-256) key pair, written as PEM text on one line with \n.
# The private key never leaves the main server; the other servers are given only the public key.
# Generate your own pair once and append it to .env:
#   pnpm keys:generate >> .env
# ACCESS_TOKEN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# ACCESS_TOKEN_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# OAuth client IDs of the two Google clients. They are not secrets. Google Cloud Console > APIs & Services >
# Credentials lists them. A User signs in to the app with an ID token issued to the app's client, and an Administrator
# signs in to the admin site with one issued to the admin site's client; each is refused on the other's sign-in, so the
# two must differ.
GOOGLE_APP_CLIENT_ID=1021723676612-aria1ohmdms787sqbvldtt8484fnf04c.apps.googleusercontent.com
GOOGLE_ADMIN_CLIENT_ID=1021723676612-23lpoe5ue36rr2a07uora5ai4qckoe87.apps.googleusercontent.com

# Email addresses of the initial Administrators, who manage Global Events on the admin site, separated by commas.
# An Administrator is not a User. The server registers these addresses when it starts with no Administrator registered,
# as on a new database. After that it ignores this setting, and Administrators register and remove each other through
# the administrative routes. Any Google account's address works, and case does not matter. Replace the example with
# your own address.
INITIAL_ADMINISTRATOR_EMAILS=admin@example.com
