// The main database's schema. Change it, then record the change as a migration (see README.md).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Stated, not inferred from tsconfig.json, so that the Docker image generates the same code before it has tsconfig.json.
  importFileExtension = "js"
  // For the one open session per User in Session.
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// A person who signed in with an SNU Google account.
model User {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Google's subject identifier ("sub"), which stays the same while the email address may change.
  googleSubject     String             @unique @map("google_subject")
  email             String
  // The profile. The name and the department stay empty until onboarding. The limits are in src/users/dto/.
  name              String             @default("")
  department        String             @default("")
  admissionYear     Int?               @map("admission_year")
  hashtags          String[]           @default([])
  // For a group study room's booking at 관정도서관 only, and never in another User's reply. The 학번 is nine digits
  // without the hyphen; an empty registered name is taken to be the name. The limits are in src/users/dto/.
  studentNumber     String?            @map("student_number")
  registeredName    String?            @map("registered_name")
  affiliation       Affiliation?
  // The Google account's name at the last sign-in, from which onboarding suggests a name and a department.
  googleName        String             @default("") @map("google_name")
  onboardedAt       DateTime?          @map("onboarded_at")
  // Made when the User is created (src/users/friend-id.ts), and never changed.
  friendId          String             @unique @map("friend_id")
  // Location Sharing as a whole. Off until the User turns it on; signing in and out leave it as it is.
  masterSwitchOn    Boolean            @default(false) @map("master_switch_on")
  sessions          Session[]
  friendshipsAsA    Friendship[]       @relation("FriendshipUserA")
  friendshipsAsB    Friendship[]       @relation("FriendshipUserB")
  inviteLinks       InviteLink[]
  questHolders      QuestHolder[]
  ledQuests         Quest[]
  questJoinRequests QuestJoinRequest[]
  questInvitations  QuestInvitation[]
  meetupsProposed   Meetup[]           @relation("MeetupProposer")
  meetupsReceived   Meetup[]           @relation("MeetupReceiver")
  partyMember       PartyMember?
  ledParties        Party[]
  partyJoinRequests PartyJoinRequest[]
  partyInvitations  PartyInvitation[]
  timetableClasses  TimetableClass[]
  tutorialProgress  TutorialProgress?
  tutorialQuests    TutorialQuestProgress[]
  resolutionEvents  ResolutionEvent[]
  userAliases       UserAlias[]
  suggestionImpressions SuggestionImpression[]
  roomRequests      RoomRequest[]
  roomConsents      RoomConsent[]
  roomNotices       RoomNotice[]

  @@map("users")
}

// 소속: 학부, 대학원 or 교환학생.
enum Affiliation {
  undergraduate
  graduate
  exchange

  @@map("affiliation")
}

// A Friend Request while acceptedAt is empty, and a friendship once it is accepted. One row for both, keyed by the two
// Users in the order of their ids, so that the database allows one of them between two Users: two Friend Requests that
// cross, or two answers to one, cannot leave two.
model Friendship {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The migration checks that userAId is less than userBId.
  userAId      String    @map("user_a_id") @db.Uuid
  userA        User      @relation("FriendshipUserA", fields: [userAId], references: [id])
  userBId      String    @map("user_b_id") @db.Uuid
  userB        User      @relation("FriendshipUserB", fields: [userBId], references: [id])
  // One of the two, who sent the Friend Request.
  senderId     String    @map("sender_id") @db.Uuid
  sentAt       DateTime  @default(now()) @map("sent_at")
  acceptedAt   DateTime? @map("accepted_at")
  // Each User's switch for Location Sharing on this friendship, at their own end.
  userASharing Boolean   @default(true) @map("user_a_sharing")
  userBSharing Boolean   @default(true) @map("user_b_sharing")

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("friendships")
}

// A link a User sends through any messenger, so that whoever accepts it becomes their Friend. It works once.
model InviteLink {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderId  String    @map("sender_id") @db.Uuid
  sender    User      @relation(fields: [senderId], references: [id])
  // The SHA-256 of the random token in the link's address, which is not stored itself.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  // Set when the link is accepted.
  usedAt    DateTime? @map("used_at")

  @@map("invite_links")
}

// A proposal from one Friend to another to meet (README.md: Meetup). It is never edited.
model Meetup {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposerId String      @map("proposer_id") @db.Uuid
  proposer   User        @relation("MeetupProposer", fields: [proposerId], references: [id])
  receiverId String      @map("receiver_id") @db.Uuid
  receiver   User        @relation("MeetupReceiver", fields: [receiverId], references: [id])
  title      String
  startsAt   DateTime    @map("starts_at")
  endsAt     DateTime?   @map("ends_at")
  // A Place from the list, or a point with the label the app showed for it. The migration checks that it is one.
  placeId    String?     @map("place_id") @db.Uuid
  place      Place?      @relation(fields: [placeId], references: [id], onDelete: Restrict)
  latitude   Float?
  longitude  Float?
  placeLabel String?     @map("place_label")
  state      MeetupState @default(proposed)
  proposedAt DateTime    @default(now()) @map("proposed_at")

  @@index([proposerId])
  @@index([receiverId])
  @@map("meetups")
}

// Expired is not among them: it is computed when a Meetup is read.
enum MeetupState {
  proposed
  accepted
  declined
  withdrawn

  @@map("meetup_state")
}

// The app signed in on one phone. A sign-in ends the User's open session, so a User has at most one.
model Session {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  user          User              @relation(fields: [userId], references: [id])
  createdAt     DateTime          @default(now()) @map("created_at")
  endedAt       DateTime?         @map("ended_at")
  endReason     SessionEndReason? @map("end_reason")
  refreshTokens RefreshToken[]

  @@unique([userId], where: { endedAt: null })
  @@map("sessions")
}

enum SessionEndReason {
  // A sign-in on another phone.
  replaced
  signed_out
  // A used refresh token came back too late to be a retry.
  refresh_token_reused

  @@map("session_end_reason")
}

// A refresh token handed out at sign-in or by a refresh. Only its SHA-256 hash is stored.
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  session   Session   @relation(fields: [sessionId], references: [id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  // Set when a refresh uses the token up or its session ends.
  revokedAt DateTime? @map("revoked_at")

  @@index([sessionId])
  @@map("refresh_tokens")
}

// A team member who signs in to the admin site. Not a User, even when the same person also uses the app.
model Administrator {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Lower case. Unlike a User's, it does not follow the Google account's address.
  email            String    @unique
  // Bound at the first sign-in.
  googleSubject    String?   @unique @map("google_subject")
  // The last sign-out. Access tokens issued before it are refused.
  tokensValidAfter DateTime? @map("tokens_valid_after")

  @@map("administrators")
}

// An Event published to every User, collected from the university's events list or created by an Administrator
// (README.md: Global Events). A Collection never changes one once it is stored.
model GlobalEvent {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title              String
  // The post's body as text, for a collected event.
  description        String
  // A Draft may have neither. A day read without a time of day is stored at 00:00 Asia/Seoul.
  startsAt           DateTime?           @map("starts_at")
  endsAt             DateTime?           @map("ends_at")
  place              String?
  // A published event has both.
  latitude           Float?
  longitude          Float?
  state              GlobalEventState    @default(draft)
  // Checked and raised by every change an Administrator makes, so that a change from an older version is refused.
  version            Int                 @default(1)
  // How it came to be published; empty while a Draft and for one discarded as a Draft. Only Administrators see it.
  publicationRoute   PublicationRoute?   @map("publication_route")
  // That an Administrator must look at it. Only Administrators see it.
  needsAdministrator Boolean             @default(false) @map("needs_administrator")
  // Moved to SourcePost, and read and written by nothing. They stay for one Release so that the old pods of a rolling
  // update keep working; a later migration drops them.
  retiredPostNumber  Int?                @unique @map("post_number")
  retiredSourceUrl   String?             @map("source_url")
  // None for an event an Administrator created.
  sessions           SourcePostSession[]
  quests             Quest[]
  questHolders       QuestHolder[]

  @@map("global_events")
}

enum GlobalEventState {
  // Not visible to Users. An Administrator publishes it or discards it.
  draft
  published
  cancelled
  // Kept, so that the next Collection does not bring its post back.
  discarded

  @@map("global_event_state")
}

enum PublicationRoute {
  administrator
  // The rules read its time and place from its post.
  rule
  judgement

  @@map("publication_route")
}

// One post on a Source that Global Events were read from. Kept whatever becomes of them, so that the next Collection
// does not bring a discarded event's post back.
model SourcePost {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source           Source
  // What identifies the post on its Source, known from the list before its page is opened: SNU Now's `bbsidx`, or
  // extra.snu's `dataSeq`.
  key              String
  address          String
  // Where the links of the post's body lead. A link hidden behind words is not in its text.
  links            String[]            @default([])
  // When the step after the Collection's answer finished with the post. Empty until then, so that the next Collection
  // of its Source takes up a post that a failure or a restart left.
  stepFinishedAt   DateTime?           @map("step_finished_at")
  // Why the step last failed on the post, and when, for Administrators. Emptied when the step finishes.
  stepFailure      String?             @map("step_failure")
  stepFailedAt     DateTime?           @map("step_failed_at")
  sessions         SourcePostSession[]
  judgement        Judgement?
  sameEventAnswers SameEventAnswer[]

  @@unique([source, key])
  @@map("source_posts")
}

// One numbered session of a Source Post, linked to the Global Event it belongs to.
model SourcePostSession {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourcePostId  String            @map("source_post_id") @db.Uuid
  number        Int
  globalEventId String            @map("global_event_id") @db.Uuid
  attachedBy    SessionAttachment @map("attached_by")
  // The rule's name or the AI's choice; empty for an event's own session.
  reason        String?
  // Whether the rules read the session's time and place when it was stored.
  readByRules   Boolean           @default(false) @map("read_by_rules")
  // Whether the post itself states the session's time, and it is not only a header's date, which is often the application
  // period.
  timeStated    Boolean           @default(false) @map("time_stated")
  // Why it waits for an Administrator's decision, as a Draft that is neither judged nor published.
  heldFor       SessionHold?      @map("held_for")
  // What the session's own Draft held before the session was attached to another event, the only place the post's title
  // and text are then kept, so that detaching can make the Draft again.
  ownDraft      Json?             @map("own_draft")
  sourcePost    SourcePost        @relation(fields: [sourcePostId], references: [id], onDelete: Cascade)
  globalEvent   GlobalEvent       @relation(fields: [globalEventId], references: [id], onDelete: Cascade)

  @@unique([sourcePostId, number])
  @@index([globalEventId])
  @@map("source_post_sessions")
}

enum SessionHold {
  // The post's body links a stored post, but their sessions do not match one to one.
  link_not_one_to_one
  // Its title and start equal those of several events, or the AI chose for it an event it chose for another session.
  several_matches
  // The AI answered that it is unsure.
  ai_unsure
  // The call failed, ran out of time, or answered something the server does not take.
  ai_failed
  // The event the AI chose can no longer be chosen, or an event it was not asked about has appeared.
  candidates_changed
  // Its place failed the checks, so it cannot be published as its own, and it met no candidate on the narrow terms that
  // attach such a session.
  place_unchecked

  @@map("session_hold")
}

enum SameEventOutcome {
  chosen
  // None of the candidates is the same event.
  none
  unsure
  // The event was chosen for another session of the post too.
  several
  failed

  @@map("same_event_outcome")
}

// What the AI answered about one session of a post, asked at most once. The session is named by its start, since a
// session a Judgement read has no row until it is settled. The row is made before the call, so that of two servers one
// calls and a server that dies during it has used its call. Only Administrators see it.
model SameEventAnswer {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourcePostId  String            @map("source_post_id") @db.Uuid
  startsAt      DateTime          @map("starts_at")
  // Empty while the call runs.
  outcome       SameEventOutcome?
  // What it was asked about and what it chose. Not references: an event may be gone by the time the answer is applied,
  // which is for the step to find.
  askedEventIds String[]          @map("asked_event_ids") @db.Uuid
  chosenEventId String?           @map("chosen_event_id") @db.Uuid
  reason        String?
  failure       String?
  modelId       String?           @map("model_id")
  claimedAt     DateTime          @map("claimed_at")
  answeredAt    DateTime?         @map("answered_at")
  sourcePost    SourcePost        @relation(fields: [sourcePostId], references: [id], onDelete: Cascade)

  @@unique([sourcePostId, startsAt])
  @@map("same_event_answers")
}

// The AI's reading of the sessions of a Source Post the rules left Drafts. One per post, since one call reads the whole
// post, whatever its tries. Only Administrators see it.
model Judgement {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourcePostId   String            @unique @map("source_post_id") @db.Uuid
  // The tries claimed, at most two. A try counts when it is claimed, so that a server that dies during the call has used
  // it. `source_posts.step_finished_at` has no such limit: the step comes back to a post until it finishes, and asks the
  // model only while a try is left.
  attempts       Int               @default(0)
  // While a server calls the model. So that another server, or the next Collection, does not call it too.
  claimedAt      DateTime?         @map("claimed_at")
  // Empty until a try ended.
  outcome        JudgementOutcome?
  // Why it could not be made: the error's name, never the post or the answer.
  failure        String?
  announcesEvent Boolean?          @map("announces_event")
  // Per session the values, the quoted lines, each check and the event it was published as: JudgedSession. Dropped
  // when no answer came.
  sessions       Json?
  modelId        String?           @map("model_id")
  judgedAt       DateTime?         @map("judged_at")
  // When its passing sessions were published, so that that happens once.
  publishedAt    DateTime?         @map("published_at")
  sourcePost     SourcePost        @relation(fields: [sourcePostId], references: [id], onDelete: Cascade)

  @@map("judgements")
}

enum JudgementOutcome {
  // The model read the post as announcing an event. Each session passed or failed the checks.
  judged
  // The model read the post as announcing no event. It stays a Draft.
  no_event
  // An error, a timeout or a malformed answer. Nothing was read.
  failed

  @@map("judgement_outcome")
}

// How a session came to be linked to its Global Event.
enum SessionAttachment {
  // The event was made from this session.
  own
  rule
  ai
  administrator

  @@map("session_attachment")
}

// What one or more Users set out to do (README.md: Quests). Its time and place belong to its Sub Quests.
model Quest {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  // Never changes.
  globalEventId String?            @map("global_event_id") @db.Uuid
  globalEvent   GlobalEvent?       @relation(fields: [globalEventId], references: [id], onDelete: Restrict)
  // One of the Holders (README.md: Quests).
  leaderId      String             @map("leader_id") @db.Uuid
  leader        User               @relation(fields: [leaderId], references: [id])
  // From 1 to 8, which the migration checks.
  capacity      Int                @default(4)
  joinPolicy    JoinPolicy         @default(closed) @map("join_policy")
  // Set for an Open or an Approval Quest and empty for a Closed one, which the migration checks.
  board         QuestBoard?
  // The recruiting post, up to 200 characters, which the migration checks.
  description   String             @default("")
  // The match server's match this Quest was created for, so that a repeated request finds it (README.md: Matching).
  matchId       String?            @unique @map("match_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at")
  holders       QuestHolder[]
  subQuests     SubQuest[]
  joinRequests  QuestJoinRequest[]
  invitations   QuestInvitation[]
  party         Party?

  @@index([globalEventId])
  @@map("quests")
}

// How Users enter a Quest or a Party.
enum JoinPolicy {
  // Whoever can see it enters at once.
  open
  // Whoever can see it asks, and the Leader accepts or declines.
  approval
  // Only by the Leader's invitation.
  closed

  @@map("join_policy")
}

// Where an Open or an Approval Quest is listed for recruiting.
enum QuestBoard {
  meal
  career
  hobby
  show

  @@map("quest_board")
}

// A User who holds a Quest. The row repeats the Quest's Global Event, so that a unique index keeps a User to one Quest
// for a Global Event.
model QuestHolder {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questId       String             @map("quest_id") @db.Uuid
  quest         Quest              @relation(fields: [questId], references: [id], onDelete: Cascade)
  userId        String             @map("user_id") @db.Uuid
  user          User               @relation(fields: [userId], references: [id])
  // The Quest's, written with the row.
  globalEventId String?            @map("global_event_id") @db.Uuid
  globalEvent   GlobalEvent?       @relation(fields: [globalEventId], references: [id], onDelete: Restrict)
  // Read when the row is written, so that the order of the times is the order of entry. In microseconds, so that the
  // Holders a Quest is created with keep the order they were given in.
  joinedAt      DateTime           @default(dbgenerated("clock_timestamp()")) @map("joined_at") @db.Timestamp(6)
  progress      SubQuestProgress[]

  @@unique([questId, userId])
  @@unique([userId, globalEventId])
  @@index([globalEventId])
  @@map("quest_holders")
}

// One step of a Quest, the same for all its Holders. The attending Sub Quest of a Quest for a Global Event stores no
// title, time or place: they are read from the Global Event. The migration checks which columns each kind fills.
model SubQuest {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questId    String             @map("quest_id") @db.Uuid
  quest      Quest              @relation(fields: [questId], references: [id], onDelete: Cascade)
  attending  Boolean            @default(false)
  title      String?
  startsAt   DateTime?          @map("starts_at")
  endsAt     DateTime?          @map("ends_at")
  // A Place from the list, a point with the label the app showed for it, or the label alone: words the User typed
  // that name no Place.
  placeId    String?            @map("place_id") @db.Uuid
  place      Place?             @relation(fields: [placeId], references: [id])
  latitude   Float?
  longitude  Float?
  placeLabel String?            @map("place_label")
  createdAt  DateTime           @default(now()) @map("created_at")
  progress   SubQuestProgress[]

  @@unique([questId], where: { attending: true })
  @@index([questId])
  @@map("sub_quests")
}

// A Sub Quest one Holder marked as done. Progress is each Holder's own.
model SubQuestProgress {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subQuestId String      @map("sub_quest_id") @db.Uuid
  subQuest   SubQuest    @relation(fields: [subQuestId], references: [id], onDelete: Cascade)
  holderId   String      @map("holder_id") @db.Uuid
  holder     QuestHolder @relation(fields: [holderId], references: [id], onDelete: Cascade)
  doneAt     DateTime    @default(now()) @map("done_at")

  @@unique([subQuestId, holderId])
  @@index([holderId])
  @@map("sub_quest_progress")
}

// A User's request to join an Approval Quest, which waits for the Leader's answer (README.md: Quests).
model QuestJoinRequest {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questId String   @map("quest_id") @db.Uuid
  quest   Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  userId  String   @map("user_id") @db.Uuid
  user    User     @relation(fields: [userId], references: [id])
  sentAt  DateTime @default(now()) @map("sent_at")

  @@unique([questId, userId])
  @@index([userId])
  @@map("quest_join_requests")
}

// The Leader's invitation of a Friend into a Quest, which waits for the Friend's answer (README.md: Quests).
model QuestInvitation {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questId String   @map("quest_id") @db.Uuid
  quest   Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
  userId  String   @map("user_id") @db.Uuid
  user    User     @relation(fields: [userId], references: [id])
  sentAt  DateTime @default(now()) @map("sent_at")

  @@unique([questId, userId])
  @@index([userId])
  @@map("quest_invitations")
}

// A group of Users who are together now (README.md: Party). It ends, and its row is deleted, when its last member
// leaves.
model Party {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  // From 1 to 8, which the migration checks.
  capacity     Int
  joinPolicy   JoinPolicy         @map("join_policy")
  leaderId     String             @map("leader_id") @db.Uuid
  leader       User               @relation(fields: [leaderId], references: [id])
  // The Party's Quest: one the opener holds, given when the Party is opened. Unique, so that one running Party has a
  // Quest. Empty once the Quest is deleted, when its last Holder dropped it.
  questId      String?            @unique @map("quest_id") @db.Uuid
  quest        Quest?             @relation(fields: [questId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now()) @map("created_at")
  members      PartyMember[]
  joinRequests PartyJoinRequest[]
  invitations  PartyInvitation[]

  @@index([leaderId])
  @@map("parties")
}

// A User in a Party. Unique for the User, so that a User is in one Party at most.
model PartyMember {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partyId  String   @map("party_id") @db.Uuid
  party    Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  userId   String   @unique @map("user_id") @db.Uuid
  user     User     @relation(fields: [userId], references: [id])
  // Read when the row is written, after the Party is locked, so that the order of the times is the order of entry.
  joinedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("joined_at")
  // The member's switch for Location Sharing with the Party.
  sharing  Boolean  @default(true)

  @@index([partyId])
  @@map("party_members")
}

// A User's request to enter an Approval Party, which waits for its Leader. Unique for the Party and the User, so that a
// User asks a Party once. It ends when it is answered, when the Party ends and when the User enters any Party.
model PartyJoinRequest {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partyId String   @map("party_id") @db.Uuid
  party   Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  userId  String   @map("user_id") @db.Uuid
  user    User     @relation(fields: [userId], references: [id])
  sentAt  DateTime @default(now()) @map("sent_at")

  @@unique([partyId, userId])
  @@index([userId])
  @@map("party_join_requests")
}

// The Leader's invitation of a Friend or a Holder of the Party's Quest into the Party, which waits for the invited User.
// Unique and ended as a request to enter is.
model PartyInvitation {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partyId String   @map("party_id") @db.Uuid
  party   Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  userId  String   @map("user_id") @db.Uuid
  user    User     @relation(fields: [userId], references: [id])
  sentAt  DateTime @default(now()) @map("sent_at")

  @@unique([partyId, userId])
  @@index([userId])
  @@map("party_invitations")
}

// One restaurant on one day, as the last Collection of its Source read it.
model RestaurantDay {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source      Source
  // A calendar day in Asia/Seoul.
  date        DateTime   @db.Date
  restaurant  String
  collectedAt DateTime   @map("collected_at")
  lines       MenuLine[]

  @@unique([date, source, restaurant])
  @@map("restaurant_days")
}

// One line of a meal's cell, as the page wrote it (docs/adr/0001-menus-kept-as-lines.md).
model MenuLine {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantDayId String        @map("restaurant_day_id") @db.Uuid
  restaurantDay   RestaurantDay @relation(fields: [restaurantDayId], references: [id], onDelete: Cascade)
  meal            Meal
  // The page's order within the restaurant's day.
  position        Int
  text            String
  // Set only when the worker is sure.
  kind            MenuLineKind?
  // A dish's text without its price, when the line ends with that price.
  name            String?
  // In won, when the line gives exactly one price.
  price           Int?

  @@unique([restaurantDayId, position])
  @@map("menu_lines")
}

enum MenuLineKind {
  // A corner or section, such as "<셀프코너> 7,000원".
  heading
  dish
  // Hours, a notice or a closure, such as "※ 운영시간 : 11:00~14:30".
  note

  @@map("menu_line_kind")
}

// In the order of the day, which is the order the meals are served in.
enum Meal {
  breakfast
  lunch
  dinner

  @@map("meal")
}

// A page or feed outside the project that the worker server collects.
enum Source {
  coop_menus
  dormitory_menus
  veterinary_menus
  // The shuttle operator's route page, for the stops and the service hours.
  shuttle_stops
  shuttle_vehicles
  // The university's events list, https://www.snu.ac.kr/snunow/events
  snu_events
  // The university's programme site, https://extra.snu.ac.kr
  extra_snu

  @@map("source")
}

// When a Source was last collected successfully and, apart from it, its last failure, so that a failure stays visible
// after a later success.
model CollectionStatus {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source            Source    @unique
  lastSucceededAt   DateTime? @map("last_succeeded_at")
  lastFailedAt      DateTime? @map("last_failed_at")
  lastFailureReason String?   @map("last_failure_reason")
  // How many posts its last Collection skipped, needing a sign-in or never reaching their page. Empty for a Source that
  // has no such posts.
  lastSkippedPosts  Int?      @map("last_skipped_posts")

  @@map("collection_statuses")
}

// A Place: a building, or a spot of the campus without a number, inside the Campus Boundary. Loaded from the seed files
// (README.md: Seed data).
model Place {
  // Computed from the origin and its identifier when the seed is loaded, not generated by the database, so that a
  // Place has the same id in every database.
  id         String      @id @db.Uuid
  origin     PlaceOrigin
  // The identifier the origin gives the entry.
  originId   String      @map("origin_id")
  // Such as `302` or `25-1`. Places such as 자하연 have none.
  number     String?
  name       String
  latitude   Float
  longitude  Float
  // Each a closed ring: [[{ latitude, longitude }, …], …].
  outlines   Json        @default("[]")
  subQuests  SubQuest[]
  meetups    Meetup[]
  classTimes ClassTime[]
  aliases    PlaceAlias[]

  @@unique([origin, originId])
  @@map("places")
}

// Where a seed entry comes from. Not a Source: seed data is not collected.
enum PlaceOrigin {
  // The university's campus map, https://map.snu.ac.kr
  campus_map
  openstreetmap
  // 국토지리정보원's 연속수치지형도 건물 layer, for the Places that the campus map does not list.
  national_map

  @@map("place_origin")
}

// The circular shuttle route 41946, loaded from the seed files (README.md: Shuttle).
model ShuttleRoute {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The operator's number for the route.
  number       String @unique
  // Along OpenStreetMap's roads from 정문 around the loop back to 정문, as [{ latitude, longitude }, …].
  line         Json
  // As the route page writes them: the seed's, then those of the last Collection of shuttle_stops.
  serviceHours String @map("service_hours")

  @@map("shuttle_routes")
}

// One of the operator's stops of the route, at the coordinates of the campus map's stop it is paired with.
model ShuttleStop {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The stop's `key` in seed/shuttle-stops.json, by which loading the seed again updates the stop in place.
  seedKey     Int    @unique @map("seed_key")
  // As the operator writes it. The worker's messages name the stop by it.
  name        String
  // From 0 at 정문.
  loopOrder   Int    @map("loop_order")
  latitude    Float
  longitude   Float
  // Where the stop is on the operator's drawing of the route, in pixels: `left` and `top` on the route page.
  drawingLeft Int    @map("drawing_left")
  drawingTop  Int    @map("drawing_top")

  @@map("shuttle_stops")
}

// A class of a User's timetable (README.md: Timetable). The User's timetable is the User's classes.
model TimetableClass {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  user       User        @relation(fields: [userId], references: [id])
  courseName String      @map("course_name")
  times      ClassTime[]

  @@index([userId])
  @@map("timetable_classes")
}

// One of the times a class is held each week. Two times of one class do not cross on a weekday.
model ClassTime {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId   String         @map("class_id") @db.Uuid
  class     TimetableClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  weekday   Weekday
  // Times of day in Asia/Seoul as `HH:MM`, which sort as the times do. The end is after the start.
  startTime String         @map("start_time")
  endTime   String         @map("end_time")
  placeId   String?        @map("place_id") @db.Uuid
  place     Place?         @relation(fields: [placeId], references: [id])
  room      String?

  @@index([classId])
  @@map("class_times")
}

// In the order of the week, Monday first.
enum Weekday {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday

  @@map("weekday")
}

// A User's 새내기 튜토리얼 (README.md: Tutorial). Each time is set or cleared only by the rules of src/tutorial/, so the
// state is read from which of them are set and never by comparing them.
model TutorialProgress {
  userId      String    @id @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id])
  // The tutorial is on: turned on by the User, or once for a User eligible by default.
  enabledAt   DateTime? @map("enabled_at")
  stoppedAt   DateTime? @map("stopped_at")
  // Every quest of the content at that time was completed. Quests added to the content later leave it set.
  finishedAt  DateTime? @map("finished_at")
  // The User closed the 내 정보 row while the tutorial was off.
  rowHiddenAt DateTime? @map("row_hidden_at")

  @@map("tutorial_progress")
}

// A Tutorial Quest the User started, by its key in content/tutorial.yaml. A key no longer in the file is ignored.
model TutorialQuestProgress {
  userId      String              @map("user_id") @db.Uuid
  user        User                @relation(fields: [userId], references: [id])
  questKey    String              @map("quest_key")
  startedAt   DateTime            @map("started_at")
  completedAt DateTime?           @map("completed_at")
  // Set with completedAt.
  completedBy TutorialCompletion? @map("completed_by")

  @@id([userId, questKey])
  @@map("tutorial_quest_progress")
}

// How a Tutorial Quest was completed: by 완료했어요 on a button quest, or, on the 관정 quest, by a booking the phone
// found, by 그냥 완료하기 after none was found, or by its skip.
enum TutorialCompletion {
  button
  checked
  forced
  skipped

  @@map("tutorial_completion")
}

// One answer of the Assistant's resolvers to a User's words, or one answer of the User to them (P07): the words
// normalised (src/common/normalise-words.ts) and the ids, never the sentence. Rows go with the account.
model ResolutionEvent {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String                 @map("user_id") @db.Uuid
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         ResolverKind
  // At most 50 characters. Empty on an edit when no Place was resolved in that message.
  words        String
  // The 초성 of the words when they are all Hangul: ㅎㄱ for 학관.
  choseong     String?
  // The resolver's answer; null on the User's own.
  result       ResolutionResult?
  // Places only: the matcher's tier that answered and, on the alias tier, whose alias it was.
  tier         ResolutionTier?
  aliasSource  ResolutionAliasSource? @map("alias_source")
  // The ids shown, in order, at most 10. On an edit, the Place it replaced.
  candidateIds String[]               @map("candidate_ids") @db.Uuid
  // The id the User chose, or rejected.
  chosenId     String?                @map("chosen_id") @db.Uuid
  outcome      ResolutionOutcome
  createdAt    DateTime               @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([kind, words, createdAt])
  @@map("resolution_events")
}

// Words a User taught the Assistant by choosing what they meant (P07): the words, normalised as resolution_events keys
// them, and the Place or Friend chosen. It answers that User alone, and is checked against the catalog or the
// friendships each time it answers. Friend aliases live only here.
model UserAlias {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       ResolverKind
  // 1 to 50 characters.
  words      String
  // A Place's id, or a Friend's user id.
  targetId   String       @map("target_id") @db.Uuid
  // How many times the User chose the target for the words.
  uses       Int          @default(1)
  createdAt  DateTime     @default(now()) @map("created_at")
  // The last choice of it, or the last time it answered.
  lastUsedAt DateTime     @default(now()) @map("last_used_at")

  @@unique([userId, kind, words, targetId])
  @@index([userId, kind, words])
  @@map("user_aliases")
}

// Words that name a Place for every User (P07), once enough distinct accounts led to it for them through the alias
// chain (src/assistant/aliases/alias-chain.ts, alias-rules.ts). Retired rather than deleted, so that what was learned
// can be counted.
model PlaceAlias {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // 1 to 50 characters, normalised.
  words      String
  placeId    String           @map("place_id") @db.Uuid
  place      Place            @relation(fields: [placeId], references: [id], onDelete: Cascade)
  source     PlaceAliasSource
  // Distinct accounts whose successful session with the words reached the Place, and that rejected it.
  supporters Int              @default(0)
  rejecters  Int              @default(0)
  // As of the last count or use. It decays from lastUsedAt and is computed again whenever it is read.
  score      Float            @default(0)
  // As of the last count: Φ∞, the expected visits to the Place from the words' own reading times the Place's one-step
  // success, and Φ₁, that reading's own one-step success, which the alias beat.
  success    Float            @default(0)
  ownSuccess Float            @default(0) @map("own_success")
  createdAt  DateTime         @default(now()) @map("created_at")
  // The last time it answered, or when it was made.
  lastUsedAt DateTime         @default(now()) @map("last_used_at")
  // Set when it stops answering.
  retiredAt  DateTime?        @map("retired_at")

  @@unique([words, placeId])
  @@index([words])
  @@map("place_aliases")
}

// Which resolver the words were given to.
enum ResolverKind {
  place
  friend
  globalEvent @map("global_event")

  @@map("resolver_kind")
}

enum ResolutionResult {
  none
  one
  several

  @@map("resolution_result")
}

// The tiers of the Place matcher (src/places/place-index.ts).
enum ResolutionTier {
  exact
  alias
  generated
  induced
  subsequence
  distance

  @@map("resolution_tier")
}

enum ResolutionAliasSource {
  personal
  global
  curated

  @@map("resolution_alias_source")
}

// Whose say-so a Place alias is: the team's (PLACE_GROUPS, which stay in code for now) or learned from Users' choices.
enum PlaceAliasSource {
  curated
  learned

  @@map("place_alias_source")
}

// Matching rules the model induced from the labelled resolution_events and the replay verified (P07 ticket 07): a
// restricted regular expression over a Place's normalised name (`name`) or the User's words (`words`) and its
// replacement (src/places/induced-rules.ts). The counts are as of the last induction. A row is never rewritten or
// deleted: a retired rule keeps retired_at, and one picked again loses it.
model InducedRule {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind      InducedRuleKind
  // 1 to 80 characters, and 1 to 40.
  pattern   String
  replace   String
  // One words it fixed when it was made, for people reading the table.
  example   String
  // The labelled words it fixed and broke, and the distinct accounts behind the fixed ones.
  fixed     Int             @default(0)
  broke     Int             @default(0)
  accounts  Int             @default(0)
  // The model that proposed it.
  model     String
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  retiredAt DateTime?       @map("retired_at")

  @@unique([kind, pattern, replace])
  @@map("induced_rules")
}

enum InducedRuleKind {
  name
  words

  @@map("induced_rule_kind")
}

// answered: a resolver answered. chosen: the User tapped a candidate. edited: the User changed a Proposal's Place.
// rejected: the User said a learned reading was wrong. Only the last three are labels.
enum ResolutionOutcome {
  answered
  chosen
  edited
  rejected

  @@map("resolution_outcome")
}

// A grey suggestion the Assistant showed a User when the chat opened, and what the User did with it (README.md:
// Assistant). It holds no text, only what measuring acceptance needs. It goes with the account.
model SuggestionImpression {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  moment        SuggestionMoment  @default(open)
  // One row for each answer of GET /assistant/suggestion: the template shown, such as lunch_with_free_friend, or null
  // when nothing was shown; every template that was eligible, the best score first; and the ids each eligible
  // template's action would take, as "<template> <kind>:<id>", by which a request the User typed instead is matched.
  template      String?
  eligible      String[]
  candidates    String[]
  // The time of day in Korea whose acceptance was read: morning, midday, afternoon or evening.
  bucket        String
  // The probability the shown template had of being shown, by which acceptance is weighted later; null when nothing
  // was shown.
  propensity    Float?
  // Whether the account is held back to the base weights.
  holdback      Boolean
  // The User's own acceptance of the suggestions shown to them in the last week, smoothed, read before the templates
  // are scored, and whether it alone held everything back; a held-back account is never gated.
  receptiveness Float
  gated         Boolean
  // When the chat opened and the suggestion was decided, shown or not.
  shownAt       DateTime          @map("shown_at")
  // The migration checks that template is null exactly for a silent outcome, that outcomeAt is set once the outcome is
  // neither silent nor shown, and questId exactly when it is confirmed.
  outcome       SuggestionOutcome @default(shown)
  outcomeAt     DateTime?         @map("outcome_at")
  // The Quest made from the suggestion's Proposal. No relation, so that the row outlives the Quest.
  questId       String?           @map("quest_id") @db.Uuid
  // The eligible template whose action the Proposal the User asked for in the chat within 10 minutes would have
  // taken, and when: a missed need when it is not the template shown.
  typedTemplate String?           @map("typed_template")
  typedAt       DateTime?         @map("typed_at")

  @@index([userId, shownAt])
  @@index([bucket, shownAt])
  @@map("suggestion_impressions")
}

// When a suggestion was decided: the chat opened, or an answer left a next line (P07 ticket 09).
enum SuggestionMoment {
  open
  answer

  @@map("suggestion_moment")
}

// An impression still shown 10 minutes after it was shown was ignored, which is read when it is analysed, not stored.
enum SuggestionOutcome {
  // Nothing was shown: no template was eligible, none reached its threshold, a cooldown held them back, or the User's
  // receptiveness did.
  silent
  shown
  // Tapped.
  accepted
  // Closed with ×.
  dismissed
  // Its Proposal's Quest was made with 만들기.
  confirmed

  @@map("suggestion_outcome")
}

// A request to book a 관정 group study room with companions (README.md: Group study room requests). The companions are
// the other Holders of its Quest: a booking party made for it, or an existing Quest the requester holds. It holds no
// 학번 and no registered name: those are read from users only when the companions reply is built.
model RoomRequest {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Not a relation, since the request outlives its Quest: a booking party is deleted when the request ends, and a
  // Quest deleted while the request gathers dissolves it.
  questId        String            @map("quest_id") @db.Uuid
  madeForBooking Boolean           @map("made_for_booking")
  requesterId    String            @map("requester_id") @db.Uuid
  requester      User              @relation(fields: [requesterId], references: [id])
  // The catalogue's id, the day (YYYY-MM-DD) and the start (HH:MM) in Korea, and the length.
  spaceId        String            @map("space_id")
  date           String
  start          String
  minutes        Int
  // The date and the start as one time, by which a request still not booked expires.
  startsAt       DateTime          @map("starts_at")
  useDesc        String?           @map("use_desc")
  status         RoomRequestStatus @default(gathering)
  // The companion the library did not recognise, who is asked to check their 내 정보.
  failedUserId   String?           @map("failed_user_id") @db.Uuid
  // Why it was dissolved, shown on the requester's card.
  reason         String?
  createdAt      DateTime          @default(now()) @map("created_at")
  consents       RoomConsent[]
  notices        RoomNotice[]

  @@index([questId])
  @@index([requesterId])
  @@index([status, startsAt])
  @@map("room_requests")
}

enum RoomRequestStatus {
  // Waiting for a companion's consent.
  gathering
  // Every current Holder but the requester consented.
  ready
  booked
  cancelled
  dissolved
  expired

  @@map("room_request_status")
}

// A companion's answer to one room request, for that request only. Deleted when the request is booked or ends.
model RoomConsent {
  requestId  String      @map("request_id") @db.Uuid
  request    RoomRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId     String      @map("user_id") @db.Uuid
  user       User        @relation(fields: [userId], references: [id])
  answeredAt DateTime?   @map("answered_at")
  consented  Boolean?

  @@id([requestId, userId])
  @@index([userId])
  @@map("room_consents")
}

// A one-time notice on a member's main screen about a room request: dissolved, booked or cancelled. Deleted once seen.
model RoomNotice {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  user      User        @relation(fields: [userId], references: [id])
  requestId String      @map("request_id") @db.Uuid
  request   RoomRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([userId])
  @@map("room_notices")
}
