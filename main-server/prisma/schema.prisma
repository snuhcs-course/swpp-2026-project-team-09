// The main database's schema. Change it, then record the change as a migration (see README.md).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Stated, not inferred from tsconfig.json, so that the Docker image generates the same code before it has tsconfig.json.
  importFileExtension = "js"
  // For the one open session per User in Session.
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// A person who signed in with an SNU Google account.
model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Google's subject identifier ("sub"), which stays the same while the email address may change.
  googleSubject String    @unique @map("google_subject")
  email         String
  sessions      Session[]

  @@map("users")
}

// The app signed in on one phone. A sign-in ends the User's open session, so a User has at most one.
model Session {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  user          User              @relation(fields: [userId], references: [id])
  createdAt     DateTime          @default(now()) @map("created_at")
  endedAt       DateTime?         @map("ended_at")
  endReason     SessionEndReason? @map("end_reason")
  refreshTokens RefreshToken[]

  @@unique([userId], where: { endedAt: null })
  @@map("sessions")
}

enum SessionEndReason {
  // A sign-in on another phone.
  replaced
  signed_out
  // A used refresh token came back too late to be a retry.
  refresh_token_reused

  @@map("session_end_reason")
}

// A refresh token handed out at sign-in or by a refresh. Only its SHA-256 hash is stored.
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  session   Session   @relation(fields: [sessionId], references: [id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  // Set when a refresh uses the token up or its session ends.
  revokedAt DateTime? @map("revoked_at")

  @@index([sessionId])
  @@map("refresh_tokens")
}

// A team member who signs in to the admin site. Not a User, even when the same person also uses the app.
model Administrator {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Lower case. Unlike a User's, it does not follow the Google account's address.
  email            String    @unique
  // Bound at the first sign-in.
  googleSubject    String?   @unique @map("google_subject")
  // The last sign-out. Access tokens issued before it are refused.
  tokensValidAfter DateTime? @map("tokens_valid_after")

  @@map("administrators")
}

// One restaurant's menus on one day, as the last collection of its source on that day read them. A later collection
// replaces every restaurant of the source on that day.
model RestaurantDay {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source      CollectionSource
  restaurant  String
  // A calendar day in Asia/Seoul.
  date        DateTime         @db.Date
  collectedAt DateTime         @map("collected_at")
  lines       MenuLine[]

  @@unique([date, source, restaurant])
  @@map("restaurant_days")
}

// One line of a meal's cell, as the page wrote it. The worker sets `kind` and `price` only when it is sure, so a line it
// cannot read is still shown as text.
model MenuLine {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantDayId String        @map("restaurant_day_id") @db.Uuid
  restaurantDay   RestaurantDay @relation(fields: [restaurantDayId], references: [id])
  meal            Meal
  // The order in which the page lists the day's lines.
  position        Int
  text            String
  kind            MenuLineKind?
  // In won, when the line gives exactly one price.
  price           Int?

  @@index([restaurantDayId])
  @@map("menu_lines")
}

enum MenuLineKind {
  // A corner or section, such as "<셀프코너> 7,000원".
  heading
  // A dish or a set.
  item
  // Operating or busy hours, a notice, such as "※ 운영시간 : 11:00~14:30".
  note

  @@map("menu_line_kind")
}

// Declared in the order of the day, which is the order the menus are served in.
enum Meal {
  breakfast
  lunch
  dinner

  @@map("meal")
}

// A page or feed the worker server collects. A new source adds its value with a migration.
enum CollectionSource {
  coop_menus
  dormitory_menus
  veterinary_menus

  @@map("collection_source")
}

// When a source was last collected successfully and, apart from it, its last failure, so that a failure stays visible
// after a later success.
model CollectionStatus {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source            CollectionSource @unique
  lastSucceededAt   DateTime?        @map("last_succeeded_at")
  lastFailedAt      DateTime?        @map("last_failed_at")
  // What went wrong, as the worker described it.
  lastFailureReason String?          @map("last_failure_reason")

  @@map("collection_statuses")
}
