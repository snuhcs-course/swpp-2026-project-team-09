// The main database's schema. Change it, then record the change as a migration (see README.md).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Stated, not inferred from tsconfig.json, so that the Docker image generates the same code before it has tsconfig.json.
  importFileExtension = "js"
  // For the one open session per User in Session.
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// A person who signed in with an SNU Google account.
model User {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Google's subject identifier ("sub"), which stays the same while the email address may change.
  googleSubject  String        @unique @map("google_subject")
  email          String
  // The profile. The name and the department stay empty until onboarding. The limits are in src/users/dto/.
  name           String        @default("")
  department     String        @default("")
  admissionYear  Int?          @map("admission_year")
  hashtags       String[]      @default([])
  // The Google account's name at the last sign-in, from which onboarding suggests a name and a department.
  googleName     String        @default("") @map("google_name")
  onboardedAt    DateTime?     @map("onboarded_at")
  // Made when the User is created (src/users/friend-id.ts), and never changed.
  friendId       String        @unique @map("friend_id")
  // Location Sharing as a whole. Off until the User turns it on; signing in and out leave it as it is.
  masterSwitchOn Boolean       @default(false) @map("master_switch_on")
  sessions       Session[]
  friendshipsAsA Friendship[]  @relation("FriendshipUserA")
  friendshipsAsB Friendship[]  @relation("FriendshipUserB")
  questHolders   QuestHolder[]
  partyMember    PartyMember?
  ledParties     Party[]
  inviteLinks    InviteLink[]
  ledQuests      Quest[]

  @@map("users")
}

// A Friend Request while acceptedAt is empty, and a friendship once it is accepted. One row for both, keyed by the two
// Users in the order of their ids, so that the database allows one of them between two Users: two Friend Requests that
// cross, or two answers to one, cannot leave two.
model Friendship {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The migration checks that userAId is less than userBId.
  userAId      String    @map("user_a_id") @db.Uuid
  userA        User      @relation("FriendshipUserA", fields: [userAId], references: [id])
  userBId      String    @map("user_b_id") @db.Uuid
  userB        User      @relation("FriendshipUserB", fields: [userBId], references: [id])
  // One of the two, who sent the Friend Request.
  senderId     String    @map("sender_id") @db.Uuid
  sentAt       DateTime  @default(now()) @map("sent_at")
  acceptedAt   DateTime? @map("accepted_at")
  // Each User's switch for Location Sharing on this friendship, at their own end.
  userASharing Boolean   @default(true) @map("user_a_sharing")
  userBSharing Boolean   @default(true) @map("user_b_sharing")

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("friendships")
}

// A link a User sends through any messenger, so that whoever accepts it becomes their Friend. It works once.
model InviteLink {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderId  String    @map("sender_id") @db.Uuid
  sender    User      @relation(fields: [senderId], references: [id])
  // The SHA-256 of the random token in the link's address, which is not stored itself.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  // Set when the link is accepted.
  usedAt    DateTime? @map("used_at")

  @@map("invite_links")
}

// The app signed in on one phone. A sign-in ends the User's open session, so a User has at most one.
model Session {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  user          User              @relation(fields: [userId], references: [id])
  createdAt     DateTime          @default(now()) @map("created_at")
  endedAt       DateTime?         @map("ended_at")
  endReason     SessionEndReason? @map("end_reason")
  refreshTokens RefreshToken[]

  @@unique([userId], where: { endedAt: null })
  @@map("sessions")
}

enum SessionEndReason {
  // A sign-in on another phone.
  replaced
  signed_out
  // A used refresh token came back too late to be a retry.
  refresh_token_reused

  @@map("session_end_reason")
}

// A refresh token handed out at sign-in or by a refresh. Only its SHA-256 hash is stored.
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  session   Session   @relation(fields: [sessionId], references: [id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  // Set when a refresh uses the token up or its session ends.
  revokedAt DateTime? @map("revoked_at")

  @@index([sessionId])
  @@map("refresh_tokens")
}

// A team member who signs in to the admin site. Not a User, even when the same person also uses the app.
model Administrator {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Lower case. Unlike a User's, it does not follow the Google account's address.
  email            String    @unique
  // Bound at the first sign-in.
  googleSubject    String?   @unique @map("google_subject")
  // The last sign-out. Access tokens issued before it are refused.
  tokensValidAfter DateTime? @map("tokens_valid_after")

  @@map("administrators")
}

// An Event published to every User, collected from the university's events list or created by an Administrator
// (README.md: Global Events). A Collection never changes one once it is stored.
model GlobalEvent {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  // The post's body as text, for a collected event.
  description  String
  // A Draft may have neither. A day read without a time of day is stored at 00:00 Asia/Seoul.
  startsAt     DateTime?        @map("starts_at")
  endsAt       DateTime?        @map("ends_at")
  place        String?
  // A published event has both.
  latitude     Float?
  longitude    Float?
  state        GlobalEventState @default(draft)
  // Checked and raised by an Administrator's edit (P12), so that an edit made from an older version is refused.
  version      Int              @default(1)
  // The `bbsidx` and address of a collected event's post. An event an Administrator creates has neither.
  postNumber   Int?             @unique @map("post_number")
  sourceUrl    String?          @map("source_url")
  quests       Quest[]
  questHolders QuestHolder[]

  @@map("global_events")
}

enum GlobalEventState {
  // Not visible to Users. An Administrator publishes it or discards it.
  draft
  published
  cancelled
  // Kept, so that the next Collection does not bring its post back.
  discarded

  @@map("global_event_state")
}

// What one or more Users set out to do (README.md: Quests). Its time and place belong to its Sub Quests.
model Quest {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  // Never changes.
  globalEventId String?       @map("global_event_id") @db.Uuid
  globalEvent   GlobalEvent?  @relation(fields: [globalEventId], references: [id], onDelete: Restrict)
  // One of the Holders (README.md: Quests).
  leaderId      String        @map("leader_id") @db.Uuid
  leader        User          @relation(fields: [leaderId], references: [id])
  // From 1 to 8, which the migration checks.
  capacity      Int           @default(4)
  joinPolicy    JoinPolicy    @default(closed) @map("join_policy")
  createdAt     DateTime      @default(now()) @map("created_at")
  holders       QuestHolder[]
  subQuests     SubQuest[]
  party         Party?

  @@index([globalEventId])
  @@map("quests")
}

// How Users enter a Quest.
enum JoinPolicy {
  // Whoever can see it enters at once.
  open
  // Whoever can see it asks, and the Leader accepts or declines.
  approval
  // Only by the Leader's invitation.
  closed

  @@map("join_policy")
}

// A User who holds a Quest. The row repeats the Quest's Global Event, so that a unique index keeps a User to one Quest
// for a Global Event.
model QuestHolder {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questId       String             @map("quest_id") @db.Uuid
  quest         Quest              @relation(fields: [questId], references: [id], onDelete: Cascade)
  userId        String             @map("user_id") @db.Uuid
  user          User               @relation(fields: [userId], references: [id])
  // The Quest's, written with the row.
  globalEventId String?            @map("global_event_id") @db.Uuid
  globalEvent   GlobalEvent?       @relation(fields: [globalEventId], references: [id], onDelete: Restrict)
  // Read when the row is written, so that the order of the times is the order of entry. In microseconds, so that the
  // Holders a Quest is created with keep the order they were given in.
  joinedAt      DateTime           @default(dbgenerated("clock_timestamp()")) @map("joined_at") @db.Timestamp(6)
  progress      SubQuestProgress[]

  @@unique([questId, userId])
  @@unique([userId, globalEventId])
  @@index([globalEventId])
  @@map("quest_holders")
}

// One step of a Quest, the same for all its Holders. The attending Sub Quest of a Quest for a Global Event stores no
// title, time or place: they are read from the Global Event. The migration checks which columns each kind fills.
model SubQuest {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  questId    String             @map("quest_id") @db.Uuid
  quest      Quest              @relation(fields: [questId], references: [id], onDelete: Cascade)
  attending  Boolean            @default(false)
  title      String?
  startsAt   DateTime?          @map("starts_at")
  endsAt     DateTime?          @map("ends_at")
  // A Place from the list, or a point with the label the app showed for it.
  placeId    String?            @map("place_id") @db.Uuid
  place      Place?             @relation(fields: [placeId], references: [id])
  latitude   Float?
  longitude  Float?
  placeLabel String?            @map("place_label")
  createdAt  DateTime           @default(now()) @map("created_at")
  progress   SubQuestProgress[]

  @@unique([questId], where: { attending: true })
  @@index([questId])
  @@map("sub_quests")
}

// A Sub Quest one Holder marked as done. Progress is each Holder's own.
model SubQuestProgress {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subQuestId String      @map("sub_quest_id") @db.Uuid
  subQuest   SubQuest    @relation(fields: [subQuestId], references: [id], onDelete: Cascade)
  holderId   String      @map("holder_id") @db.Uuid
  holder     QuestHolder @relation(fields: [holderId], references: [id], onDelete: Cascade)
  doneAt     DateTime    @default(now()) @map("done_at")

  @@unique([subQuestId, holderId])
  @@index([holderId])
  @@map("sub_quest_progress")
}

// A group of Users who are together now (README.md: Party). It ends, and its row is deleted, when its last member
// leaves.
model Party {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String
  // From 1 to 8, which the migration checks.
  capacity   Int
  joinPolicy PartyJoinPolicy @map("join_policy")
  leaderId   String          @map("leader_id") @db.Uuid
  leader     User            @relation(fields: [leaderId], references: [id])
  // The mark: one of the creator's Quests, set at creation. Unique, so that one running Party carries a Quest. Empty
  // once the Quest is deleted, when its last Holder dropped it.
  questId    String?         @unique @map("quest_id") @db.Uuid
  quest      Quest?          @relation(fields: [questId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now()) @map("created_at")
  members    PartyMember[]

  @@index([leaderId])
  @@map("parties")
}

enum PartyJoinPolicy {
  // Anyone joins at once.
  open
  // The Leader accepts each request.
  approval
  // Unlisted, entry by the Leader's invitation only.
  closed

  @@map("party_join_policy")
}

// A User in a Party. Unique for the User, so that a User is in one Party at most.
model PartyMember {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partyId  String   @map("party_id") @db.Uuid
  party    Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  userId   String   @unique @map("user_id") @db.Uuid
  user     User     @relation(fields: [userId], references: [id])
  // Read when the row is written, after the Party is locked, so that the order of the times is the order of entry.
  joinedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("joined_at")
  // The member's switch for Location Sharing with the Party.
  sharing  Boolean  @default(true)

  @@index([partyId])
  @@map("party_members")
}

// One restaurant on one day, as the last Collection of its Source read it.
model RestaurantDay {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source      Source
  // A calendar day in Asia/Seoul.
  date        DateTime   @db.Date
  restaurant  String
  collectedAt DateTime   @map("collected_at")
  lines       MenuLine[]

  @@unique([date, source, restaurant])
  @@map("restaurant_days")
}

// One line of a meal's cell, as the page wrote it (docs/adr/0001-menus-kept-as-lines.md).
model MenuLine {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantDayId String        @map("restaurant_day_id") @db.Uuid
  restaurantDay   RestaurantDay @relation(fields: [restaurantDayId], references: [id], onDelete: Cascade)
  meal            Meal
  // The page's order within the restaurant's day.
  position        Int
  text            String
  // Set only when the worker is sure.
  kind            MenuLineKind?
  // A dish's text without its price, when the line ends with that price.
  name            String?
  // In won, when the line gives exactly one price.
  price           Int?

  @@unique([restaurantDayId, position])
  @@map("menu_lines")
}

enum MenuLineKind {
  // A corner or section, such as "<셀프코너> 7,000원".
  heading
  dish
  // Hours, a notice or a closure, such as "※ 운영시간 : 11:00~14:30".
  note

  @@map("menu_line_kind")
}

// In the order of the day, which is the order the meals are served in.
enum Meal {
  breakfast
  lunch
  dinner

  @@map("meal")
}

// A page or feed outside the project that the worker server collects.
enum Source {
  coop_menus
  dormitory_menus
  veterinary_menus
  // The shuttle operator's route page, for the stops and the service hours.
  shuttle_stops
  shuttle_vehicles
  // The university's events list, https://www.snu.ac.kr/snunow/events
  snu_events

  @@map("source")
}

// When a Source was last collected successfully and, apart from it, its last failure, so that a failure stays visible
// after a later success.
model CollectionStatus {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source            Source    @unique
  lastSucceededAt   DateTime? @map("last_succeeded_at")
  lastFailedAt      DateTime? @map("last_failed_at")
  lastFailureReason String?   @map("last_failure_reason")

  @@map("collection_statuses")
}

// A Place: a building, or a spot of the campus without a number, inside the Campus Boundary. Loaded from the seed files
// (README.md: Seed data).
model Place {
  // Computed from the origin and its identifier when the seed is loaded, not generated by the database, so that a
  // Place has the same id in every database.
  id        String      @id @db.Uuid
  origin    PlaceOrigin
  // The identifier the origin gives the entry.
  originId  String      @map("origin_id")
  // Such as `302` or `25-1`. Places such as 자하연 have none.
  number    String?
  name      String
  latitude  Float
  longitude Float
  // Each a closed ring: [[{ latitude, longitude }, …], …].
  outlines  Json        @default("[]")
  subQuests SubQuest[]

  @@unique([origin, originId])
  @@map("places")
}

// Where a seed entry comes from. Not a Source: seed data is not collected.
enum PlaceOrigin {
  // The university's campus map, https://map.snu.ac.kr
  campus_map
  openstreetmap
  // 국토지리정보원's 연속수치지형도 건물 layer, for the Places that the campus map does not list.
  national_map

  @@map("place_origin")
}

// The circular shuttle route 41946, loaded from the seed files (README.md: Shuttle).
model ShuttleRoute {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The operator's number for the route.
  number       String @unique
  // Along OpenStreetMap's roads from 정문 around the loop back to 정문, as [{ latitude, longitude }, …].
  line         Json
  // As the route page writes them: the seed's, then those of the last Collection of shuttle_stops.
  serviceHours String @map("service_hours")

  @@map("shuttle_routes")
}

// One of the operator's stops of the route, at the coordinates of the campus map's stop it is paired with.
model ShuttleStop {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The stop's `key` in seed/shuttle-stops.json, by which loading the seed again updates the stop in place.
  seedKey     Int    @unique @map("seed_key")
  // As the operator writes it. The worker's messages name the stop by it.
  name        String
  // From 0 at 정문.
  loopOrder   Int    @map("loop_order")
  latitude    Float
  longitude   Float
  // Where the stop is on the operator's drawing of the route, in pixels: `left` and `top` on the route page.
  drawingLeft Int    @map("drawing_left")
  drawingTop  Int    @map("drawing_top")

  @@map("shuttle_stops")
}
