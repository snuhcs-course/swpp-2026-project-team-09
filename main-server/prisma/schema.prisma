generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// SQL migrations retain database CHECK constraints, functional/partial indexes,
// and the PostGIS extension. Do not replace those migrations with db push.
model User {
  id String @id @db.Uuid
  google_sub String @unique
  email String @unique
  display_name String
  avatar_url String?
  location_sharing Boolean @default(false)
  location_epoch Int @default(0)
  department String?
  admission_year Int?
  interests Json @default("[]")
  status_message String?
  profile_version Int @default(1)
  timetable_version Int @default(1)
  timetable Json @default("{\"timezone\":\"Asia/Seoul\",\"semesterStartsOn\":null,\"semesterEndsOn\":null,\"entries\":[]}")
  private_events PrivateEvent[]
  memberships PartyMember[]
  sent_friendships Friendship[] @relation("sender")
  received_friendships Friendship[] @relation("receiver")
  consumed_requests ConsumedMatchRequest[]
  sent_meetups Meetup[] @relation("meetup_sender")
  received_meetups Meetup[] @relation("meetup_recipient")
  @@map("users")
}
model Event {
  id String @id @db.Uuid
  title String
  description String
  starts_at DateTime @db.Timestamptz(6)
  ends_at DateTime @db.Timestamptz(6)
  location_name String
  latitude Float?
  longitude Float?
  status String
  source_url String?
  source String @default("manual")
  external_id String?
  version Int @default(1)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  parties Party[]
  @@unique([source, external_id])
  @@map("events")
}
model EventRevision {
  id Int @id
  revision BigInt @default(0)
  @@map("event_revision")
}
model Party {
  id String @id @db.Uuid
  title String
  event_id String? @db.Uuid
  max_members Int
  visibility String @default("public")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  event Event? @relation(fields: [event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members PartyMember[]
  quests Quest[]
  match_batches MatchBatch[]
  consumed_requests ConsumedMatchRequest[]
  meetup Meetup?
  @@map("parties")
}
model PartyMember {
  party_id String @db.Uuid
  user_id String @db.Uuid
  sharing_enabled Boolean @default(true)
  party Party @relation(fields: [party_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user User @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([party_id, user_id])
  @@map("party_members")
}
model Friendship {
  id String @id @db.Uuid
  sender_id String @db.Uuid
  receiver_id String @db.Uuid
  status String @default("pending")
  sender_sharing Boolean @default(false)
  receiver_sharing Boolean @default(false)
  sender User @relation("sender", fields: [sender_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receiver User @relation("receiver", fields: [receiver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@map("friendships")
}
model Quest {
  id String @id @db.Uuid
  party_id String @db.Uuid
  title String
  starts_at DateTime @db.Timestamptz(6)
  ends_at DateTime @db.Timestamptz(6)
  location_name String
  version Int @default(1)
  status String @default("active")
  party Party @relation(fields: [party_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  meetup Meetup?
  @@map("quests")
}
model MatchBatch {
  request_id String @id @db.Uuid
  party_id String @db.Uuid
  fingerprint String
  party Party @relation(fields: [party_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@map("match_batches")
}
model ConsumedMatchRequest {
  request_id String @id @db.Uuid
  user_id String @db.Uuid
  party_id String @db.Uuid
  user User @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  party Party @relation(fields: [party_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@map("consumed_match_requests")
}
model Outbox {
  sequence BigInt @id @default(autoincrement())
  id String @unique @db.Uuid
  envelope Json
  event_revision BigInt?
  delivered_at DateTime? @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  @@map("outbox")
}

model Meetup {
  id String @id @db.Uuid
  sender_id String @db.Uuid
  recipient_id String @db.Uuid
  title String
  starts_at DateTime @db.Timestamptz(6)
  ends_at DateTime @db.Timestamptz(6)
  location_name String
  status String @default("pending")
  version Int @default(1)
  party_id String? @unique @db.Uuid
  quest_id String? @unique @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  sender User @relation("meetup_sender", fields: [sender_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipient User @relation("meetup_recipient", fields: [recipient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  party Party? @relation(fields: [party_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quest Quest? @relation(fields: [quest_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([sender_id, created_at])
  @@index([recipient_id, created_at])
  @@map("meetups")
}

model PrivateEvent {
  id String @id @db.Uuid
  owner_id String @db.Uuid
  title String
  description String
  starts_at DateTime @db.Timestamptz(6)
  ends_at DateTime @db.Timestamptz(6)
  location_name String
  latitude Float?
  longitude Float?
  version Int @default(1)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  owner User @relation(fields: [owner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([owner_id, starts_at])
  @@map("private_events")
}
