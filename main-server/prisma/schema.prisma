// The main database's schema. Change it, then record the change as a migration (see README.md).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Stated, not inferred from tsconfig.json, so that the Docker image generates the same code before it has tsconfig.json.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// A person who signed in with an SNU Google account.
model User {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Google's subject identifier ("sub"), which stays the same while the email address may change.
  googleSubject String         @unique @map("google_subject")
  email         String
  refreshTokens RefreshToken[]

  @@map("users")
}

// A refresh token handed to a User at sign-in. Only its SHA-256 hash is stored.
model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")

  @@map("refresh_tokens")
}
