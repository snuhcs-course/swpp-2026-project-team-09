// The main database's schema. Change it, then record the change as a migration (see README.md).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Stated, not inferred from tsconfig.json, so that the Docker image generates the same code before it has tsconfig.json.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// A person who signed in with an SNU Google account.
model User {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Google's subject identifier ("sub"), which stays the same while the email address may change.
  googleSubject String         @unique @map("google_subject")
  email         String
  // The User's single switch for all of their Location Sharing. Off until the User turns it on; signing out turns it
  // off.
  masterSwitch  Boolean        @default(false) @map("master_switch")
  refreshTokens RefreshToken[]

  @@map("users")
}

// A refresh token handed to a User at sign-in or by a refresh. Only its SHA-256 hash is stored.
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  // A sign-in starts a family, and each refresh hands on the family of the token it replaces.
  familyId  String    @default(dbgenerated("gen_random_uuid()")) @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  // Set when a refresh uses the token up or a sign-out revokes it. A revoked token is refused.
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
