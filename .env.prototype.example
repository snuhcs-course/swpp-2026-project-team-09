# Copy to .env.prototype.local and fill local secrets. Never commit the copy.
# Generate each secret independently: openssl rand -hex 32
POSTGRES_PASSWORD=
DB_MAIN_PASSWORD=
DB_MATCH_PASSWORD=
JWT_SECRET=
INTERNAL_API_KEY=
# Google OAuth web client is also the backend ID-token audience.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Naver mobile map ID belongs in mobile/.env.local as NAVER_MAP_CLIENT_ID.
ADMIN_EMAILS=
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
ADMIN_API_URL=http://localhost:3001
# Optional actual embedding service; absent = clearly labeled rule matching.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
KAKAO_REST_API_KEY=
